{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ResourceDevopsAccess",
            "Effect": "Allow",
            "Action": [
                "ec2:*",
                "eks:*",
                "ecr:*",
                "rds:*",
                "s3:*",
                "cloudformation:*",
                "elasticloadbalancing:*",
                "autoscaling:*",
                "secretsmanager:*",
                "kms:*",
                "logs:*",
                "cloudwatch:*",
                "lambda:*",
                "route53:*",
                "acm:*",
                "dynamodb:*",
                "ssm:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DevopsIamAccess",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy",
                "iam:CreatePolicy",
                "iam:DeletePolicy",
                "iam:GetRole",
                "iam:ListRoles",
                "iam:ListRolePolicies",
                "iam:ListAttachedRolePolicies",
                "iam:GetPolicy",
                "iam:GetPolicyVersion"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DevopsPassRoleRestricted",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": [
                "arn:aws:iam::013484737363:role/eksctl-*",
                "arn:aws:iam::013484737363:role/pet-shop-*",
                "arn:aws:iam::013484737363:role/ng-*"
            ],
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": [
                        "ec2.amazonaws.com",
                        "eks.amazonaws.com",
                        "eks-nodegroup.amazonaws.com"
                    ]
                }
            }
        }
    ]
}